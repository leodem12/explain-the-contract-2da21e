# Copy to .env and fill in real values. Never commit .env.

# --- LLM provider (env-driven; defaults to the real provider) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- JWT signing secret (REQUIRED) ---
# Must be a long, random, high-entropy string (>= 32 chars for HS256).
# ASP.NET Core maps the "__" separator to nested config (Jwt:Key).
# The app fails fast at startup if this is missing.
Jwt__Key=
